:8080 {
    request_body {
        max_size 27MB
    }
    encode zstd gzip
    handle /api/* {
        reverse_proxy api:4100
    }
    handle {
        reverse_proxy web:3100
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}
