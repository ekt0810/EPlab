NODE_ENV=development
APP_URL=http://127.0.0.1:3100
API_HOST=127.0.0.1
API_PORT=4100
DATABASE_URL=postgresql://eplab:GENERATE_WITH_SETUP@127.0.0.1:55432/eplab
SECRET_KEY=GENERATE_64_HEX_CHARACTERS_WITH_SETUP
DATA_DIR=./data
MAIL_MODE=local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_FROM is a bare verified email address. Use npm run mail:configure.
# Port 465 uses TLS; other SMTP ports require STARTTLS (no plaintext fallback).
PUBLIC_MODE=false
TRUST_PROXY=false
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ADMIN_1_EMAIL=admin1@example.com
ADMIN_2_EMAIL=admin2@example.com
LOCAL_POSTGRES=true
LOCAL_PG_PASSWORD=GENERATE_WITH_SETUP
NEXT_TELEMETRY_DISABLED=1
BACKUP_RETAIN=14
BACKUP_DESTINATION=
# Docker only: generate two different random hexadecimal passwords.
DB_ADMIN_PASSWORD=
DB_PASSWORD=
# Bank information is entered in the admin UI after reauthentication.
# No real payments until a bank account AND a published premium lesson are configured.

# Optional classroom AI. Keep these server-side; no NEXT_PUBLIC_ prefix.
# Set an OpenAI-compatible API base URL ending in /v1, model and key.
# Leave unset for clearly labelled curriculum lookup mode.
EP_CLASSROOM_AI_BASE_URL=
EP_CLASSROOM_AI_MODEL=
EP_CLASSROOM_AI_KEY=
