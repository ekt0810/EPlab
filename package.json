{
  "name": "ep-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "tsx scripts/local.ts",
    "db:migrate": "tsx apps/api/src/migrate.ts",
    "db:seed": "tsx apps/api/src/seed.ts",
    "content:handbooks": "tsx scripts/install-handbooks.ts",
    "admin:setup": "tsx scripts/admin.ts",
    "build": "npm run build -w @ep/api && npm run build -w @ep/web",
    "typecheck": "tsc --noEmit && npm run typecheck -w @ep/web",
    "test": "tsx --test --test-concurrency=1 tests/lab.test.ts tests/integration.test.ts tests/ngrok.test.ts tests/internet.test.ts",
    "test:browser": "tsx scripts/browser-check.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "maintenance": "tsx scripts/maintenance.ts",
    "start": "tsx scripts/local.ts --production",
    "admin:email": "tsx scripts/admin-email.ts",
    "bank:configure": "tsx scripts/configure-bank.ts",
    "verify:videos": "tsx scripts/video-check.ts",
    "test:backup": "tsx scripts/backup-check.ts",
    "server:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/server-control.ps1 -Action Install",
    "server:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/server-control.ps1 -Action Start",
    "server:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/server-control.ps1 -Action Stop",
    "server:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/server-control.ps1 -Action Restart",
    "server:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/server-control.ps1 -Action Status",
    "server:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/server-control.ps1 -Action Backup",
    "server:verify-backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/server-control.ps1 -Action VerifyBackup",
    "server:export-recovery": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/server-control.ps1 -Action ExportRecovery",
    "mail:configure": "tsx scripts/configure-mail.ts",
    "ngrok:configure": "tsx scripts/configure-ngrok.ts",
    "ngrok:enable": "tsx scripts/ngrok-control.ts enable",
    "ngrok:disable": "tsx scripts/ngrok-control.ts disable",
    "ngrok:status": "tsx scripts/ngrok-control.ts status",
    "ngrok:check": "tsx scripts/ngrok-control.ts check",
    "test:ngrok": "tsx --test tests/ngrok.test.ts",
    "internet:check": "tsx scripts/internet-check.ts",
    "test:internet": "tsx --test tests/internet.test.ts",
    "test:classroom": "tsx --test tests/classroom.test.ts",
    "test:classroom:browser": "tsx scripts/classroom-browser.ts",
    "classroom:preview": "tsx scripts/classroom-preview.ts",
    "classroom:preview:stop": "tsx scripts/classroom-preview-stop.ts"
  },
  "devDependencies": {
    "@inquirer/prompts": "8.8.0",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "embedded-postgres": "18.6.0-beta.19",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
